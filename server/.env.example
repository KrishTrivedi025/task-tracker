# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tasktracker?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Token expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173
